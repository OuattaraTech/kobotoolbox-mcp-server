# Copy this file to .env and fill in your own values. .env is git-ignored.

# Your KoboToolbox API token.
# Get it at: https://kf.kobotoolbox.org/#/account/security -> API key
KOBO_API_TOKEN=

# Kobo server base URL.
#   https://kf.kobotoolbox.org  -> global server
#   https://eu.kobotoolbox.org  -> European server
KOBO_BASE_URL=https://kf.kobotoolbox.org

# Where generated reports (.xlsx/.docx/.pdf) are written.
# Defaults to ./out inside the project if unset.
KOBO_OUTPUT_DIR=

# Python interpreter used to render reports. Install its dependencies with:
#   $PYTHON_BIN -m pip install -r requirements.txt
# Run the kobo_doctor tool to check the whole setup.
PYTHON_BIN=python3

# Only needed for the HTTP transport (sharing the server over the network).
MCP_ACCESS_KEY=

# Retry policy for the Kobo API (it throttles bursts and returns sporadic 5xx).
# Reads and throttled requests are retried; writes are never retried on 5xx.
KOBO_RETRY_ATTEMPTS=3
KOBO_RETRY_BASE_DELAY_MS=700
